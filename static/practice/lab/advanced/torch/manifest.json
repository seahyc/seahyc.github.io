{
  "schemaVersion": 2,
  "assessments": [
    {
      "id": "transformer-posttrain",
      "title": "Train a causal transformer with SFT, DPO and GRPO",
      "prerequisites": [
        "posttrain-bench",
        "language-model-loss"
      ],
      "files": [
        "candidate.py",
        "evaluate.py",
        "manifest.json",
        "requirements.txt",
        "README.md"
      ],
      "scopes": {
        "smoke": {
          "criteria": [
            {
              "name": "objective_gradients",
              "metric": "objective_error",
              "op": "lt",
              "value": 1e-05
