              "metric": "sft_heldout_accuracy",
              "op": "gte",
              "value": 0.7
            },
            {
              "name": "dpo_heldout_preserved",
              "metric": "dpo_heldout_nll_ratio",
              "op": "lt",
              "value": 1.5
            },
            {
              "name": "grpo_heldout_preserved",
              "metric": "grpo_heldout_nll_ratio",
              "op": "lt",
              "value": 1.5
            },
            {
              "name": "dpo_updates",
              "metric": "dpo_parameter_delta",
              "op": "gt",
              "value": 1e-05
            },
            {
              "name": "grpo_updates",
              "metric": "grpo_parameter_delta",
              "op": "gt",
              "value": 1e-05
            },
            {
              "name": "heldout_nll",
              "metric": "sft_heldout_nll",
