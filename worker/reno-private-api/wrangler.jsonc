{
  "name": "reno-private-api",
  "main": "index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "seahyingcong.com/reno/api/*",
      "zone_name": "seahyingcong.com"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
