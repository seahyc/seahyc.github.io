{
  "name": "forest-crew",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4180",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4180",
    "test": "node --test tests/*.test.mjs",
    "build:public": "tsc --noEmit && vite build --mode public --outDir dist-public"
  },
  "dependencies": {
    "@babylonjs/core": "9.25.0",
    "@babylonjs/havok": "1.3.14",
    "@babylonjs/loaders": "9.25.0",
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
